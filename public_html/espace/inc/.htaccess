# Ce dossier contient la configuration et le code interne de l'espace
# adhérents. Rien ici ne doit être accessible depuis un navigateur : ces
# fichiers sont inclus par les pages PHP, jamais ouverts directement.

# Apache 2.4 (Hostinger)
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Apache 2.2, au cas où
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
