# Les photos d'un album « Nos Sorties » hébergé sur ce site sont publiques
# une fois en ligne (elles apparaissent sur nos-sorties.html), mais l'accès
# direct par URL reste interdit : elles passent toujours par
# telecharger.php (type=sortie_album), qui retrouve le nom de fichier en
# base plutôt que de le prendre dans l'URL.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
