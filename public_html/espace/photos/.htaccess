# Les fichiers déposés ici sont réservés aux adhérents connectés. L'accès
# direct par URL est interdit : ils sont servis par telecharger.php, qui
# vérifie d'abord que la personne est bien connectée.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
