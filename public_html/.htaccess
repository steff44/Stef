# En-têtes de sécurité HTTP, appliqués à tout le site (pages statiques et
# espace adhérents) — choix explicite de l'utilisatrice, 31/08/2026.
# N'affecte que les en-têtes de réponse : aucune redirection, aucun impact
# sur le routage existant.

# Type MIME forcé pour le favicon (piège rencontré le 31/08/2026 : le
# favicon PNG puis .ico restait invisible dans tous les navigateurs testés,
# même sans aucun cache — alors que le fichier s'ouvrait normalement en
# accès direct). Cause probable : combiné à X-Content-Type-Options: nosniff
# ci-dessous, un Content-Type incorrect ou absent pour .ico/.png sur cet
# hébergement empêcherait le navigateur d'utiliser le fichier comme icône,
# tout en le laissant s'afficher normalement en navigation directe (chemin
# de rendu différent). Ces deux lignes forcent le bon type quel que soit le
# réglage par défaut du serveur.
<IfModule mod_mime.c>
  AddType image/vnd.microsoft.icon .ico
  AddType image/png .png
</IfModule>

<IfModule mod_headers.c>
  # Empêche un navigateur de "deviner" le type d'un fichier autrement que
  # par l'en-tête Content-Type envoyé par le serveur (protège contre
  # certaines attaques par confusion de type MIME).
  Header always set X-Content-Type-Options "nosniff"

  # Interdit d'afficher le site dans un <iframe> d'un autre domaine
  # (protection contre le "clickjacking") — SAMEORIGIN reste permissif pour
  # nos propres pages entre elles.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Limite les informations envoyées au site de destination quand un
  # visiteur clique sur un lien sortant (garde l'origine, jamais le chemin
  # complet ni les paramètres d'URL).
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Le site est entièrement en HTTPS (myfocal.online et focalclub.fr) :
  # force le navigateur à toujours utiliser HTTPS pour ce domaine pendant un
  # an, même si un lien ou un favori pointait vers http://.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Politique de sécurité du contenu (CSP) : n'autorise que les ressources
  # du site lui-même, plus l'exception réellement utilisée — les vignettes
  # Google Drive (Nos Sorties, voir infos-albums.php). 'unsafe-inline' reste
  # nécessaire pour script-src/style-src : le site n'a pas de build, il
  # utilise des scripts et attributs style="" en ligne un peu partout.
  #
  # Piège rencontré le 01/09/2026 : les vignettes Nos Sorties ont cessé de
  # s'afficher après l'ajout de cette CSP, alors que https://drive.google.com
  # était bien autorisé. Cause, trouvée via la console du navigateur
  # (message CSP explicite, domaine bloqué nommé) : les adresses générées
  # par infos-albums.php (https://drive.google.com/thumbnail?id=...)
  # redirigent Google lui-même vers https://lh3.googleusercontent.com/d/...
  # pour l'image réelle — et la CSP s'applique à l'adresse finale après
  # redirection, pas à l'adresse de départ. https://*.googleusercontent.com
  # (plusieurs sous-domaines lh1-lh6 possibles côté Google) ajouté en
  # conséquence.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://drive.google.com https://*.googleusercontent.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'self'; form-action 'self' mailto:; base-uri 'self'; object-src 'none'"
</IfModule>
